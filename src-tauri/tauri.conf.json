{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "marie",
  "version": "0.1.0",
  "identifier": "net.flaxeneel2.marie",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "marie",
        "width": 800,
        "height": 600
      },
      {
        "label": "overlay",
        "url": "overlay",
        "title": "marie overlay",
        "width": 1,
        "height": 1,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
